{
  "nacara": {
    "font": {
      "font-sans": {
        "$type": "fontFamily",
        "$value": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
      },
      "font-mono": {
        "$type": "fontFamily",
        "$value": "ui-monospace, \"JetBrains Mono\", \"Fira Code\", \"SFMono-Regular\", Menlo, monospace"
      }
    },
    "size": {
      "font-size": {
        "$type": "dimension",
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "font-size-2xs": {
        "$type": "dimension",
        "$value": {
          "value": 0.75,
          "unit": "rem"
        }
      },
      "font-size-xs": {
        "$type": "dimension",
        "$value": {
          "value": 0.875,
          "unit": "rem"
        }
      },
      "font-size-sm": {
        "$type": "dimension",
        "$value": {
          "value": 0.9375,
          "unit": "rem"
        }
      },
      "font-size-lg": {
        "$type": "dimension",
        "$value": {
          "value": 1.1875,
          "unit": "rem"
        }
      },
      "font-size-xl": {
        "$type": "dimension",
        "$value": {
          "value": 1.5,
          "unit": "rem"
        }
      },
      "font-size-2xl": {
        "$type": "dimension",
        "$value": {
          "value": 2.25,
          "unit": "rem"
        }
      },
      "font-size-code": {
        "$type": "dimension",
        "$value": {
          "value": 0.875,
          "unit": "rem"
        }
      },
      "space-1": {
        "$type": "dimension",
        "$value": {
          "value": 0.25,
          "unit": "rem"
        }
      },
      "space-2": {
        "$type": "dimension",
        "$value": {
          "value": 0.5,
          "unit": "rem"
        }
      },
      "space-3": {
        "$type": "dimension",
        "$value": {
          "value": 0.75,
          "unit": "rem"
        }
      },
      "space-4": {
        "$type": "dimension",
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "space-6": {
        "$type": "dimension",
        "$value": {
          "value": 1.5,
          "unit": "rem"
        }
      },
      "space-8": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "rem"
        }
      },
      "space-12": {
        "$type": "dimension",
        "$value": {
          "value": 3,
          "unit": "rem"
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": {
          "value": 0.5,
          "unit": "rem"
        }
      },
      "radius-sm": {
        "$type": "dimension",
        "$value": {
          "value": 0.25,
          "unit": "rem"
        }
      },
      "splash-width": {
        "$type": "dimension",
        "$value": {
          "value": 68,
          "unit": "rem"
        }
      },
      "layout-gap": {
        "$type": "dimension",
        "$value": "{nacara.size.space-8}"
      },
      "sidebar-width": {
        "$type": "dimension",
        "$value": {
          "value": 17,
          "unit": "rem"
        }
      },
      "toc-width": {
        "$type": "dimension",
        "$value": {
          "value": 15,
          "unit": "rem"
        }
      },
      "navbar-height": {
        "$type": "dimension",
        "$value": {
          "value": 3.5,
          "unit": "rem"
        }
      },
      "navbar-blur": {
        "$type": "dimension",
        "$value": {
          "value": 8,
          "unit": "px"
        }
      },
      "control-height": {
        "$type": "dimension",
        "$value": {
          "value": 2.25,
          "unit": "rem"
        }
      },
      "control-radius": {
        "$type": "dimension",
        "$value": "{nacara.size.radius-sm}"
      }
    },
    "number": {
      "font-weight-heading": {
        "$type": "fontWeight",
        "$value": 700
      },
      "line-height": {
        "$type": "number",
        "$value": 1.65
      },
      "line-height-heading": {
        "$type": "number",
        "$value": 1.2
      },
      "line-height-code": {
        "$type": "number",
        "$value": 1.6
      }
    },
    "css": {
      "content-width": {
        "$type": "string",
        "$value": "75ch"
      },
      "navbar-opacity": {
        "$type": "string",
        "$value": "85%"
      },
      "code-inline-text": {
        "$type": "string",
        "$value": "currentColor"
      },
      "code-max-height": {
        "$type": "string",
        "$value": "none"
      }
    },
    "color": {
      "bg": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "bg-subtle": {
        "$type": "color",
        "$value": "#f6f7f9"
      },
      "bg-raised": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "border": {
        "$type": "color",
        "$value": "#d0d7de"
      },
      "text": {
        "$type": "color",
        "$value": "#1b1f24"
      },
      "text-muted": {
        "$type": "color",
        "$value": "#5a6470"
      },
      "primary": {
        "$type": "color",
        "$value": "#6669d7"
      },
      "primary-contrast": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "primary-subtle": {
        "$type": "color",
        "$value": "#ececfb"
      },
      "note": {
        "$type": "color",
        "$value": "#6669d7"
      },
      "tip": {
        "$type": "color",
        "$value": "#17935f"
      },
      "warning": {
        "$type": "color",
        "$value": "#b5730c"
      },
      "danger": {
        "$type": "color",
        "$value": "#cf3b3b"
      },
      "heading": {
        "$type": "color",
        "$value": "{nacara.color.text}"
      },
      "code-inline-bg": {
        "$type": "color",
        "$value": "{nacara.color.bg-subtle}"
      },
      "code-inline-border": {
        "$type": "color",
        "$value": "{nacara.color.border}"
      }
    },
    "shadow": {
      "shadow": {
        "$type": "shadow",
        "$value": [
          {
            "color": "#1018280f",
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 1,
              "unit": "px"
            },
            "blur": {
              "value": 2,
              "unit": "px"
            },
            "spread": {
              "value": 0,
              "unit": "px"
            }
          },
          {
            "color": "#1018280f",
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 4,
              "unit": "px"
            },
            "blur": {
              "value": 12,
              "unit": "px"
            },
            "spread": {
              "value": 0,
              "unit": "px"
            }
          }
        ]
      },
      "shadow-floating": {
        "$type": "shadow",
        "$value": "{nacara.shadow.shadow}"
      }
    }
  },
  "tok": {
    "color": {
      "comment": {
        "$type": "color",
        "$value": "#a0a1a7"
      },
      "string": {
        "$type": "color",
        "$value": "#50a14f"
      },
      "number": {
        "$type": "color",
        "$value": "#986801"
      },
      "constant": {
        "$type": "color",
        "$value": "#986801"
      },
      "constructor": {
        "$type": "color",
        "$value": "#4078f2"
      },
      "property": {
        "$type": "color",
        "$value": "#e45649"
      },
      "escape": {
        "$type": "color",
        "$value": "#0184bc"
      },
      "keyword": {
        "$type": "color",
        "$value": "#a626a4"
      },
      "operator": {
        "$type": "color",
        "$value": "#0184bc"
      },
      "function": {
        "$type": "color",
        "$value": "#4078f2"
      },
      "type": {
        "$type": "color",
        "$value": "#c18401"
      },
      "namespace": {
        "$type": "color",
        "$value": "#4078f2"
      },
      "variable": {
        "$type": "color",
        "$value": "#383a42"
      },
      "parameter": {
        "$type": "color",
        "$value": "#383a42"
      },
      "punctuation": {
        "$type": "color",
        "$value": "#383a42"
      },
      "tag": {
        "$type": "color",
        "$value": "#e45649"
      },
      "attribute": {
        "$type": "color",
        "$value": "#986801"
      },
      "preprocessor": {
        "$type": "color",
        "$value": "#a626a4"
      },
      "invalid": {
        "$type": "color",
        "$value": "#e45649"
      },
      "inserted": {
        "$type": "color",
        "$value": "#50a14f"
      },
      "deleted": {
        "$type": "color",
        "$value": "#e45649"
      }
    }
  }
}
