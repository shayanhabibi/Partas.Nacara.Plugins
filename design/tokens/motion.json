      "selector": "[data-motion=\"card\"][data-size=\"small\"]",
      "trigger": "hover",
      "duration": 500,
      "easing": {
        "type": "CUSTOM_SPRING",
        "mass": 1,
        "stiffness": 300,
        "damping": 20
      },
      "changes": [
        {
          "property": "background-color",
          "from": {
            "token": "nacara.color.bg-raised",
            "value": "#ffffff"
          },
          "to": {
            "value": "#f7f7ff"
          }
        },
        {
          "property": "border-radius",
          "from": {
            "token": "nacara.size.radius",
            "value": "8px"
          },
          "to": {
            "value": "12px"
          }
        },
        {
          "property": "box-shadow",
          "from": {
            "value": "none"
          },
          "to": {
            "token": "nacara.shadow.shadow",
            "value": "0px 1px 2px 0px #1018280f, 0px 4px 12px 0px #1018280f"
          }
        },
        {
          "layer": "Accent",
          "part": "[data-motion-part=\"accent\"]",
          "property": "width",
          "from": {
            "value": "40px"
          },
          "to": {
            "value": "80px"
          }
        },
        {
          "layer": "Accent",
          "part": "[data-motion-part=\"accent\"]",
          "property": "opacity",
          "from": {
            "value": "1"
          },
          "to": {
            "value": "0.8"
          }
        }
      ],
      "notTranslated": []
    },
    {
