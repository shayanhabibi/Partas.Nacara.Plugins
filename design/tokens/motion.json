{
  "version": 1,
  "hovers": [
    {
      "name": "navbar-link",
      "selector": ".nacara-navbar__link:not([data-active=\"true\"]):not([aria-current])",
      "trigger": "hover",
      "duration": 200,
      "easing": {
        "type": "EASE_OUT"
      },
      "changes": [
        {
          "property": "background-color",
          "from": {
            "value": "transparent"
          },
          "to": {
            "token": "nacara.color.bg-subtle",
            "value": "#f6f7f9"
          }
        },
        {
          "property": "color",
          "from": {
            "token": "nacara.color.text-muted",
            "value": "#5a6470"
          },
          "to": {
            "token": "nacara.color.text",
            "value": "#1b1f24"
          }
        }
      ],
      "notTranslated": []
    },
    {
      "name": "sidebar-link",
      "selector": ".nacara-sidebar__link:not([aria-current=\"page\"])",
      "trigger": "hover",
      "duration": 1200,
