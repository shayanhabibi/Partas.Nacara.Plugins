<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Partas.Nacara.Plugins.Tailwind</RootNamespace>
        <AssemblyName>Partas.Nacara.Plugins.Tailwind</AssemblyName>
        <PackageId>Partas.Nacara.Plugins.Tailwind</PackageId>
        <Title>Partas.Nacara.Plugins.Tailwind</Title>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Version>0.1.0</Version><AssemblyVersion>0.0.0.0</AssemblyVersion>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Binary.fs" />
        <Compile Include="Program.fs" />
        <None Include="../../README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Nacara.Core" Version="2.0.0-beta.4" />
    </ItemGroup>

</Project>
