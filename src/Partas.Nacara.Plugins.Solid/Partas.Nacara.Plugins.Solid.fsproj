<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Partas.Nacara.Plugins.Solid</RootNamespace>
        <AssemblyName>Partas.Nacara.Plugins.Solid</AssemblyName>
        <PackageId>Partas.Nacara.Plugins.Solid</PackageId>
        <Title>Partas.Nacara.Plugins.Solid</Title>
        <Description>Live Partas.Solid examples in Nacara pages, compiled at build time.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Version>0.1.0</Version><AssemblyVersion>0.0.0.0</AssemblyVersion>
        <!-- Not published until Partas.Solid 3 is on NuGet: its default version would resolve the old one. -->
        <IsPackable>false</IsPackable>
        <WarningsAsErrors>$(WarningsAsErrors);FS0025</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Types.fs" />
        <Compile Include="Scan.fs" />
        <Compile Include="Generate.fs" />
        <Compile Include="Workspace.fs" />
        <Compile Include="Compile.fs" />
        <Compile Include="Solid.fs" />
        <EmbeddedResource Include="assets/loader.js" LogicalName="Partas.Nacara.Plugins.Solid.assets.loader.js" />
        <EmbeddedResource Include="assets/bundle.mjs" LogicalName="Partas.Nacara.Plugins.Solid.assets.bundle.mjs" />
        <None Include="../../README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Nacara.Core" Version="2.0.0-beta.6" />
    </ItemGroup>

</Project>
